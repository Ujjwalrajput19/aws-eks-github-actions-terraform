### Provider
region             = "ap-south-1"
availability_zones = ["ap-south-1a", "ap-south-1b"]
environment  = "dev"


###### ECR
ecr_repo_name = "aws-eks-2048-app"


###### VPC
vpc_cidr = "10.0.0.0/16"
public_subnet_cidr_blocks = [
  "10.0.1.0/24",
  "10.0.2.0/24",
]
private_subnet_cidr_blocks = [
  "10.0.3.0/24",
  "10.0.4.0/24",
]

##### EKS
cluster_name="ujjwal-eks-cluster"
cluster_version="1.37"
desired_capacity = 2
instance_type = "t3.medium"
max_capacity =5
min_capacity =1


